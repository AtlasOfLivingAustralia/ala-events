event:
  hosts: [ {{ include "es-nodes" .Values.elasticsearch }} ]
  requestTimeout: 30000
  maxRetries: 3
  maxResultWindow: 100000
  index: event
#  index: event-databox
eventOccurrence:
  hosts: [ {{ include "es-nodes" .Values.elasticsearch }} ]
  requestTimeout: 30000
  maxRetries: 3
  maxResultWindow: 100000
  index: event
#  index: event-databox
apiKey: "{{ .Values.esApi.apiKey }}"
port: {{ .Values.esApi.service.targetPort }}
