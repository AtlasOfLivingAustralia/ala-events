apiDownloads: "https://api.test.ala.org.au/dataset/{datasetKey}"
datasetEml: "https://collections-test.ala.org.au/ws/eml/{datasetKey}"
alaNamematching: "https://namematching-ws.ala.org.au/api"
ala:
  namematching: "https://namematching-ws.ala.org.au/api"
  bie: https://bie-ws.ala.org.au/ws
  biocache: https://biocache-ws.ala.org.au/ws
  images: https://images.ala.org.au/ws
