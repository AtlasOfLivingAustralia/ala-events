port: {{ .Values.graphqlApi.service.port }}
debug: true
NODE_DEBUG: http node index.js
organization: ala
apiEs: http://{{ include "ala-events.fullname" . }}-es-api-service:{{ .Values.esApi.service.port }}
apiEsKey: "{{ .Values.esApi.apiKey }}"
es2vt: http://{{ include "ala-events.fullname" . }}-es2vt-service:{{ .Values.es2vt.service.port }}
apiDownloads: {{ .Values.api.download }}
datasetEml: {{ .Values.dataset.eml }}
alaNamematching: {{ .Values.namematching.url }}
ala:
  namematching: {{ .Values.namematching.url }}
  bie: {{ .Values.bie.url }}
  biocache: {{ .Values.biocache.url }}
  images: {{ .Values.images.url }}
