event:
  hosts: [ {{ .Values.elasticsearch.hosts }} ]
  index: {{ .Values.elasticsearch.indexName }}
  requestTimeout: 120000
  maxRetries: 3
  maxResultWindow: 100000
  username: {{ .Values.elasticsearch.username }}
  password: {{ .Values.elasticsearch.password }}
port: {{ .Values.es2vt.service.targetPort }}
apiKey: "{{ .Values.esApi.apiKey }}"