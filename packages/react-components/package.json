{
  "name": "gbif-react-components",
  "version": "1.0.0",
  "description": "React components for use in GBIFs coming websites",
  "module": "./build/esm/index.js",
  "main": "./build/cjs/index.cjs",
  "browser": "./dist/lib/gbif-react-components.js",
  "exports": {
    "import": "./build/esm/index.js",
    "default": "./build/cjs/index.cjs"
  },
  "scripts": {
    "build": "path-exists .env.production.json && shx cp .env.production.json .env.json && echo \"Using .env.production.json\";  npx webpack --mode=production",
    "build:test": "path-exists .env.development.json && shx cp .env.development.json .env.json && echo \"Build with .env.development.json \";  npx webpack --mode=development",
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve-translations": "npx serve locales/dist/ -p 5002 --cors",
    "watch-translations": "npx nodemon locales/build.js -w locales/ -i locales/dist/",
    "build-translations": "node locales/build",
    "serve": "npx http-server ./ -p 4200 --cors -o ala-demo.html",
    "prestart": "echo \"This app requires node 24.3.0 \nCurrent version is \" ; node -v",
    "start": "path-exists .env.development.json && shx cp .env.development.json .env.json && echo \"Running with .env.development.json\"; node locales/build.js; start-storybook -p 6006;",
    "build-storybook": "npm run build-locales; build-storybook -o ./dist",
    "build-client": "npm run build-locales; npm run build-storybook; npm run build; npx gulp; npx gzipper compress --brotli --include js,css,html,txt,json,map ./dist",
    "build-locales": "node locales/build",
    "generate": "npx plop --plopfile ./tools/plopfile.js",
    "add-component": "npm run generate component",
    "add-range-filter": "npm run generate rangeFilter",
    "add-enum-filter": "npm run generate enumFilter",
    "add-suggestKey-filter": "npm run generate suggestKeyFilter",
    "add-suggest-filter": "npm run generate suggestFilter",
    "add-text-filter": "npm run generate textFilter"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/runtime": "^7.29.14",
    "@emotion/babel-preset-css-prop": "^11.12.0",
    "@emotion/react": "^11.14.0",
    "@hello-pangea/dnd": "^16.6.0",
    "@turf/bbox": "^6.5.0",
    "@turf/bbox-polygon": "^6.5.0",
    "@turf/kinks": "^6.5.0",
    "@turf/simplify": "^6.5.0",
    "axios": "^1.21.1",
    "d3": "^7.9.2",
    "doi-regex": "^0.1.17",
    "dompurify": "^2.5.9",
    "downshift": "^6.1.12",
    "fast-deep-equal": "^3.1.3",
    "fast-json-stable-stringify": "^2.1.0",
    "highcharts": "10.3.3",
    "highcharts-pattern-fill": "^3.0.3",
    "highcharts-react-official": "^3.2.3",
    "history": "^5.3.0",
    "js-base64": "^3.9.6",
    "latlon-geohash": "^2.0.0",
    "mapbox-gl": "^2.15.0",
    "markdown-it": "^13.0.2",
    "match-sorter": "^6.4.0",
    "md5": "^2.3.0",
    "nanoid": "^3.3.20",
    "object-hash": "^3.0.0",
    "ol": "^6.15.1",
    "ol-mapbox-style": "^8.2.1",
    "proj4": "^2.23.0",
    "query-string": "^7.1.3",
    "queue-promise": "^2.2.1",
    "re-resizable": "^6.11.2",
    "react": "^17.0.2",
    "react-apexcharts": "1.9.0",
    "react-dom": "^17.0.2",
    "react-fast-compare": "^3.2.3",
    "react-icons": "4.12.0",
    "react-intl": "^5.25.1",
    "react-markdown": "^5.0.3",
    "react-resize-detector": "^9.1.1",
    "react-router-dom": "^5.3.4",
    "react-toast": "^1.0.3",
    "react-use": "^17.6.1",
    "reakit": "^1.3.11",
    "uncontrollable": "^7.2.1",
    "url-regex": "^5.0.0",
    "use-debounce": "^6.0.1",
    "use-local-storage": "^3.0.0",
    "use-query-params": "1.2.3",
    "wellknown": "^0.5.0",
    "wicket": "1.3.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/node": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@emotion/babel-plugin": "^11.13.5",
    "@storybook/addon-a11y": "^6.5.16",
    "@storybook/addon-actions": "^6.5.16",
    "@storybook/addon-knobs": "^6.4.0",
    "@storybook/addon-links": "^6.5.16",
    "@storybook/addon-storysource": "^6.5.16",
    "@storybook/addons": "^6.5.16",
    "@storybook/builder-webpack5": "^6.5.16",
    "@storybook/manager-webpack5": "^6.5.16",
    "@storybook/react": "^6.5.16",
    "babel-loader": "^8.4.1",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "flat": "^5.0.2",
    "gulp": "^5.0.1",
    "gulp-if": "^3.0.0",
    "gulp-replace": "^1.1.4",
    "gzipper": "^8.3.0",
    "md5-file": "^5.0.0",
    "nodemon": "^2.0.22",
    "path-exists-cli": "^2.0.0",
    "plop": "^4.0.5",
    "pseudoloc": "^1.1.0",
    "regenerator-runtime": "^0.14.1",
    "shx": "^0.4.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  }
}
